    scroll-behavior: smooth;
  }
  body {
    background-color: #0f0f1a;
    color: #e0e0e8;
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  h1, h2, h3, h4, h5, h6 {
    color: #e0e0e8;
    font-weight: 600;
    line-height: 1.25;
  }
  p {
    color: #8888a8;
    line-height: 1.625;
  }
  a {
    color: #4fc3f7;
    transition: color 0.2s;
  }
  a:hover {
    color: #29b6f6;
  }
}@layer components{.btn-primary {
    background: linear-gradient(135deg, #4fc3f7, #29b6f6);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    box-shadow: 0 10px 15px -3px rgba(79, 195, 247, 0.25);
    transition: all 0.2s;
    transform: scale(1);
    display: inline-block;
  }
  .btn-primary:hover {
    box-shadow: 0 20px 25px -5px rgba(79, 195, 247, 0.3);
    transform: scale(1.05);
  }
  .btn-outline {
    border: 1px solid #4fc3f7;
    color: #4fc3f7;
    background: transparent;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    transition: all 0.2s;
    display: inline-block;
  }
  .btn-outline:hover {
    background-color: #4fc3f7;
    color: white;
  }
  .section-divider {
    height: 1px;
    background: linear-gradient(to right, transparent, #4fc3f7, transparent);
  }
  .card {
    background-color: #1a1a2e;
    padding: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(79, 195, 247, 0.1);
    transition: border-color 0.2s;
  }
  .card:hover {
    border-color: rgba(79, 195, 247, 0.2);
  }
  .feature-card {
    background-color: #1a1a2e;
    padding: 2rem;
    border-radius: 1rem;
    border: 1px solid rgba(79, 195, 247, 0.1);
    transition: all 0.3s;
  }
  .feature-card:hover {
    border-color: rgba(79, 195, 247, 0.3);
    box-shadow: 0 10px 15px -3px rgba(79, 195, 247, 0.1);
    transform: scale(1.05);
  }
  .nav-sticky {
    background-color: rgba(15, 15, 26, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(79, 195, 247, 0.1);
  }
  .hero-bg {
    background: linear-gradient(to bottom right, #0f0f1a, #1a1a2e, #0f0f1a);
  }
  .logo-gradient {
    background: linear-gradient(135deg, #4fc3f7, #f06292, #ff9800);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
}@layer utilities{.animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
  }
  .animate-slide-up {
    animation: slideUp 0.8s ease-out forwards;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
}@property --tw-translate-x{syntax: "*";
